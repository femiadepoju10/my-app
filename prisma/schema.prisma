generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

model users {
  id                      String    @id @default(uuid())
  name                    String
  email                   String    @unique
   phone                   String?
   bio                     String?   @db.VarChar(500)
   passwordHash            String    @map("password_hash")
  role                    String    @default("user")
   paystackRecipientCode   String?   @map("paystack_recipient_code")
   smsEnabled             Boolean   @default(false) @map("sms_enabled")
   emailVerified           String?   @map("email_verified")
  verificationToken       String?   @map("verification_token")
  verificationTokenExpiry String?   @map("verification_token_expiry")
   resetToken              String?   @map("reset_token")
   resetTokenExpiry        String?   @map("reset_token_expiry")
   sellerVerificationStatus String?  @map("seller_verification_status")
   verificationNote        String?   @db.VarChar(500) @map("verification_note")
   verifiedAt              DateTime? @map("verified_at")
   createdAt               DateTime  @default(now()) @db.Timestamptz(6) @map("created_at")
  deletedAt               DateTime? @map("deleted_at")

  productsSold            products[]          @relation("sellerProducts")
  buyerTransactions       transactions[]      @relation("transactionBuyer")
  sellerTransactions      transactions[]      @relation("transactionSeller")
  payoutsReceived         payouts[]
  disputesOpened          disputes[]
  reviewsWritten          reviews[]           @relation("reviewsWritten")
  reviewsReceived         reviews[]           @relation("reviewsReceived")
  notifications           notifications[]
  wishlists               wishlists[]
  sentMessages            messages[]
  pushSubscription        push_subscriptions?

  @@map("users")
}

model products {
  id          String    @id @default(uuid())
  sellerId    String    @map("seller_id")
  title       String
  description String
  category    String
  condition   ProductCondition
  price       Int
  location    String
  status      ProductStatus @default(active)
  createdAt   DateTime  @default(now()) @db.Timestamptz(6) @map("created_at")
  updatedAt   DateTime  @default(now()) @db.Timestamptz(6) @map("updated_at")

  seller       users            @relation("sellerProducts", fields: [sellerId], references: [id])
  images       productImages[]
  transactions transactions[]
  wishlists    wishlists[]

  @@index([sellerId])
  @@index([status])
  @@index([category])
  @@index([createdAt])
  @@index([category, status])
  @@map("products")
}

model productImages {
  id        String   @id @default(uuid())
  productId String   @map("product_id")
  imageUrl  String   @map("image_url")
  sortOrder Int      @default(0) @map("sort_order")

  product products @relation(fields: [productId], references: [id], onDelete: Cascade)

  @@index([productId])
  @@map("product_images")
}

model transactions {
  id               String            @id @default(uuid())
  productId        String            @map("product_id")
  buyerId          String            @map("buyer_id")
  sellerId         String            @map("seller_id")
  itemPrice        Int               @map("item_price")
  serviceFee       Int               @map("service_fee")
  totalAmount      Int               @map("total_amount")
  status           TransactionStatus @default(payment_pending)
  createdAt        DateTime          @default(now()) @db.Timestamptz(6) @map("created_at")
  updatedAt        DateTime          @default(now()) @db.Timestamptz(6) @map("updated_at")
  rejectionReason  String?           @map("rejection_reason")
  rejectionPhotos  String?           @map("rejection_photos")
  disputeNote      String?           @map("dispute_note")

  product    products     @relation(fields: [productId], references: [id])
  buyer      users        @relation("transactionBuyer", fields: [buyerId], references: [id])
  seller     users        @relation("transactionSeller", fields: [sellerId], references: [id])
  payments   payments[]
  payouts    payouts[]
  refunds    refunds[]
   disputes   disputes?
   reviews    reviews?
   messages   messages[]
   deliveryTracking DeliveryTracking?

  @@index([buyerId])
  @@index([sellerId])
  @@index([productId])
  @@index([status])
  @@map("transactions")
}

model payments {
  id              String          @id @default(uuid())
  transactionId   String          @map("transaction_id")
  paystackRef     String          @unique @map("paystack_ref")
  amount          Int
  status          PaymentStatus   @default(pending)
  gatewayResponse String?         @map("gateway_response")
  paidAt          String?         @map("paid_at")

  transaction transactions @relation(fields: [transactionId], references: [id])

  @@index([transactionId])
  @@map("payments")
}

model payouts {
  id            String      @id @default(uuid())
  transactionId String      @map("transaction_id")
  sellerId      String      @map("seller_id")
  amount        Int
  status        PayoutStatus @default(pending)
  paystackRef   String?     @map("paystack_ref")
  paidAt        String?     @map("paid_at")

  transaction transactions @relation(fields: [transactionId], references: [id])
  seller      users        @relation(fields: [sellerId], references: [id])

  @@index([transactionId])
  @@index([sellerId])
  @@map("payouts")
}

model refunds {
  id            String      @id @default(uuid())
  transactionId String      @map("transaction_id")
  amount        Int
  reason        String?
  status        RefundStatus @default(pending)
  paystackRef   String?     @map("paystack_ref")
  createdAt     DateTime    @default(now()) @db.Timestamptz(6) @map("created_at")

  transaction transactions @relation(fields: [transactionId], references: [id])

  @@index([transactionId])
  @@map("refunds")
}

model disputes {
  id            String        @id @default(uuid())
  transactionId String        @unique @map("transaction_id")
  openedById    String        @map("opened_by_id")
  reason        String
  evidence      String?
  status        DisputeStatus @default(open)
  resolution    String?
  createdAt     DateTime      @default(now()) @db.Timestamptz(6) @map("created_at")

  transaction transactions @relation(fields: [transactionId], references: [id])
  openedBy    users         @relation(fields: [openedById], references: [id])

  @@index([transactionId])
  @@index([openedById])
  @@map("disputes")
}

model DeliveryTracking {
  id            String         @id @default(uuid())
  transactionId String         @unique @map("transaction_id")
  status        DeliveryStatus @default(shipping)
  shippedAt     DateTime?      @map("shipped_at")
  shippedNote   String?        @map("shipped_note")
  deliveredAt   DateTime?      @map("delivered_at")
  deliveredNote String?        @map("delivered_note")
  proofPhoto    String?        @map("proof_photo")
  createdAt     DateTime       @default(now()) @db.Timestamptz(6) @map("created_at")
  updatedAt     DateTime       @default(now()) @db.Timestamptz(6) @map("updated_at")

  transaction transactions @relation(fields: [transactionId], references: [id])

  @@map("delivery_tracking")
}

enum DeliveryStatus {
  shipping
  in_transit
  delivered
  confirmed
}

model notifications {
  id        String   @id @default(uuid())
  userId    String   @map("user_id")
  type      String
  message   String
  readAt    String?  @map("read_at")
  createdAt DateTime @default(now()) @db.Timestamptz(6) @map("created_at")

  user users @relation(fields: [userId], references: [id])

  @@index([userId])
  @@map("notifications")
}

model reviews {
  id            String   @id @default(uuid())
  transactionId String   @unique @map("transaction_id")
  reviewerId    String   @map("reviewer_id")
  revieweeId    String   @map("reviewee_id")
  rating        Int
  comment       String?
  createdAt     DateTime @default(now()) @db.Timestamptz(6) @map("created_at")

  transaction transactions @relation(fields: [transactionId], references: [id])
  reviewer    users        @relation("reviewsWritten", fields: [reviewerId], references: [id])
  reviewee    users        @relation("reviewsReceived", fields: [revieweeId], references: [id])

  @@index([transactionId])
  @@index([reviewerId])
  @@index([revieweeId])
  @@map("reviews")
}

model wishlists {
  id        String   @id @default(uuid())
  userId    String   @map("user_id")
  productId String   @map("product_id")
  createdAt DateTime @default(now()) @db.Timestamptz(6) @map("created_at")

  user    users    @relation(fields: [userId], references: [id])
  product products @relation(fields: [productId], references: [id])

  @@unique([userId, productId])
  @@index([userId])
  @@index([productId])
  @@map("wishlists")
}

model messages {
  id        String   @id @default(uuid())
  transactionId String @map("transaction_id")
  senderId    String @map("sender_id")
  message     String @db.VarChar(2000)
  createdAt   DateTime @default(now()) @db.Timestamptz(6) @map("created_at")

  transaction transactions @relation(fields: [transactionId], references: [id])
  sender      users       @relation(fields: [senderId], references: [id])

  @@index([transactionId])
  @@index([senderId])
  @@index([createdAt])
  @@map("messages")
}

model push_subscriptions {
  id        String   @id @default(uuid())
  userId    String   @unique @map("user_id")
  endpoint  String   @db.Text
  keys      Json
  createdAt DateTime @default(now()) @db.Timestamptz(6) @map("created_at")
  updatedAt DateTime @default(now()) @db.Timestamptz(6) @map("updated_at")

  user users @relation(fields: [userId], references: [id])

  @@index([userId])
  @@map("push_subscriptions")
}

enum ProductCondition {
  new
  like_new
  good
  fair
  used
}

enum ProductStatus {
  active
  reserved
  sold
  removed
}

enum TransactionStatus {
  payment_pending
  payment_confirmed
  seller_contacted
  item_delivered
  inspection_pending
  accepted
  rejected
  disputed
  payout_pending
  payout_completed
  completed
  refund_pending
  refund_completed
}

enum PaymentStatus {
  pending
  successful
  failed
  refunded
}

enum PayoutStatus {
  pending
  processing
  completed
  failed
}

enum RefundStatus {
  pending
  approved
  processing
  completed
  failed
}

enum DisputeStatus {
  open
  seller_accepted_return
  seller_disputed
  admin_reviewing
  refunded
  seller_paid
}
