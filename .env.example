# Database (PostgreSQL — Vercel Hobby has no built-in DB)
# Use Supabase, Neon, or similar external provider
# For Supabase: postgresql://postgres:PASSWORD@db.xxx.supabase.co:5432/postgres?sslmode=require
# For Neon:     postgresql://xxx@ep-xxx.eu-central-1.aws.neon.tech/db?sslmode=require
DATABASE_URL=

# Auth (NextAuth v4)
# On Vercel, NEXTAUTH_URL is auto-set to your deployment URL
# Generate secret: openssl rand -base64 32
NEXTAUTH_SECRET=

# Payment (Paystack)
PAYSTACK_SECRET_KEY=
PAYSTACK_PUBLIC_KEY=
PAYSTACK_WEBHOOK_SECRET=

# Images (Cloudinary)
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# Email (Resend)
RESEND_API_KEY=

# Base URL (for client-side links)
NEXT_PUBLIC_BASE_URL=http://localhost:3000

# Push Notifications (VAPID)
NEXT_PUBLIC_VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=

# SMS Notifications (Twilio — optional)
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_PHONE_NUMBER=

# AI (OpenAI — optional)
OPENAI_API_KEY=
